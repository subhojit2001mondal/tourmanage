rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAgency() {
      return isSignedIn() && exists(/databases/$(database)/documents/agencies/$(request.auth.uid));
    }

    function isVerifiedAgency() {
      return isAgency() && get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.kycStatus == 'verified';
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // Users (Customers & Admins)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Agencies (B2B)
    match /agencies/{agencyId} {
      allow read: if true;
      allow create: if isOwner(agencyId);
      allow update: if isOwner(agencyId);
      allow delete: if isOwner(agencyId);
    }

    // Travel Packages
    match /packages/{packageId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.agencyId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.agencyId == request.auth.uid;
    }
  }
}
